<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_hr_request_sign_wizard" model="ir.ui.view">
    <field name="name">hr.request.sign.wizard.form</field>
    <field name="model">hr.request.sign.wizard</field>
    <field name="arch" type="xml">
      <form string="Upload Signed Document">
        <group>
          <field name="request_id"/>
          <field name="filename" invisible="1"/>
          <field name="document" filename="filename" options="{'accepted_file_extensions': '.pdf'}"/>
        </group>
        <p class="text-muted mb-3">Upload the manually signed PDF. Confirming will mark the request as Signed.</p>
        <footer>
          <button name="action_confirm" type="object" string="Confirm Signature" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
