<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="hr_request_type_list_view" model="ir.ui.view">
    <field name="name">hr.request.type.list</field>
    <field name="model">hr.request.type</field>
    <field name="arch" type="xml">
      <list string="Request Types" default_order="sequence, name">
        <field name="sequence" column_invisible="1"/>
        <field name="code" column_invisible="1"/>
        <field name="name" string="Request Type" decoration-bf="1"/>
        <field name="active" string="Active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>
  <record id="hr_request_type_form_view" model="ir.ui.view">
    <field name="name">hr.request.type.form</field>
    <field name="model">hr.request.type</field>
    <field name="arch" type="xml">
      <form string="Request Type">
        <sheet>
          <group string="General Information">
            <field name="name" string="Request Type" placeholder="Example: Work Certificate"/>
            <field name="sequence" string="Display Order"/>
            <field name="active" string="Active" widget="boolean_toggle"/>
            <field name="code" invisible="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_hr_request_type" model="ir.actions.act_window">
    <field name="name">Request Types</field>
    <field name="res_model">hr.request.type</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
