<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_hr_request_reject_wizard" model="ir.ui.view">
    <field name="name">hr.request.reject.wizard.form</field>
    <field name="model">hr.request.reject.wizard</field>
    <field name="arch" type="xml">
      <form string="Reject Request">
        <group>
          <field name="request_id"/>
          <field name="reason_code"/>
          <field name="reason" invisible="reason_code != 'other'" required="reason_code == 'other'"/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Reject" class="btn-danger"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
